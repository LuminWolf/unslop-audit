{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./src/slop-audit/dist/index.js"],
  "rules": {
    "slop-audit/arbitrary-spacing": "warn",
    "slop-audit/tw-purple-gradient": "error",
    "slop-audit/rainbow-gradient": "error",
    "slop-audit/tw-gradient-class": "warn",
    "slop-audit/label-emoji": "error",
    "slop-audit/greeting": "warn",
